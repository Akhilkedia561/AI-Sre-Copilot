# ==============================================================================
# AI SRE Copilot — environment configuration
# ==============================================================================
# Copy to .env and fill in real values. Never commit .env to git.
# ==============================================================================

# ---- LLM provider ------------------------------------------------------------
# Recommended: Groq (free, no credit card, very fast)
#   Sign up at https://console.groq.com and create an API key.
LLM_API_KEY=gsk_your_groq_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# OpenAI alternative (needs a payment method):
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini

# ---- Slack -------------------------------------------------------------------
# Incoming webhook URL. Get one at https://api.slack.com/apps.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxxxx

# ---- Backends the agent queries ---------------------------------------------
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100

# ---- Behaviour ---------------------------------------------------------------
LLM_MAX_ITERATIONS=8
LLM_TIMEOUT_SECONDS=25
MAX_INCIDENTS_PER_MINUTE=30
FALLBACK_ON_LLM_FAILURE=true
LOG_LEVEL=INFO
